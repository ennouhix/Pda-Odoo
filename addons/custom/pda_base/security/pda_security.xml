<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Catégorie et privilège affichés dans la fiche utilisateur. -->
        <record id="module_category_pda" model="ir.module.category">
            <field name="name">PDA</field>
            <field name="sequence">26</field>
        </record>

        <record id="res_groups_privilege_pda" model="res.groups.privilege">
            <field name="name">PDA</field>
            <field name="category_id" ref="module_category_pda"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_pda_user" model="res.groups">
            <field name="name">Opérateur PDA</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_pda"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Accès aux endpoints de l'application PDA
                (recherche produit, liste des emplacements).</field>
        </record>

        <record id="group_pda_manager" model="res.groups">
            <field name="name">Responsable PDA</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_pda"/>
            <field name="implied_ids" eval="[(4, ref('group_pda_user'))]"/>
            <field name="comment">Responsable PDA : accès au journal des
                opérations en plus des droits opérateur.</field>
        </record>

    </data>
</odoo>
