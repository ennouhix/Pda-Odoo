<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================= -->
        <!-- Emplacements internes scannables                              -->
        <!-- ============================================================= -->
        <record id="loc_zone_a" model="stock.location">
            <field name="name">Zone A — Visserie &amp; outillage</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
            <field name="barcode">LOC-ZONE-A</field>
        </record>

        <record id="loc_a1" model="stock.location">
            <field name="name">A1 — Rayon visserie</field>
            <field name="location_id" ref="loc_zone_a"/>
            <field name="usage">internal</field>
            <field name="barcode">LOC-A1</field>
        </record>

        <record id="loc_a2" model="stock.location">
            <field name="name">A2 — Rayon outillage</field>
            <field name="location_id" ref="loc_zone_a"/>
            <field name="usage">internal</field>
            <field name="barcode">LOC-A2</field>
        </record>

        <record id="loc_b1" model="stock.location">
            <field name="name">B1 — Réserve</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
            <field name="barcode">LOC-B1</field>
        </record>

        <!-- ============================================================= -->
        <!-- Catalogue de démonstration (codes-barres EAN-13 valides)       -->
        <!-- ============================================================= -->
        <record id="product_vis_m6" model="product.product">
            <field name="name">Vis inox M6 x 40 — boîte de 100</field>
            <field name="default_code">VIS-001</field>
            <field name="barcode">2000000000015</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">12.90</field>
            <field name="standard_price">7.10</field>
        </record>

        <record id="product_ecu_m6" model="product.product">
            <field name="name">Écrou inox M6 — boîte de 200</field>
            <field name="default_code">ECU-002</field>
            <field name="barcode">2000000000022</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">9.50</field>
            <field name="standard_price">4.80</field>
        </record>

        <record id="product_perceuse" model="product.product">
            <field name="name">Perceuse sans fil 18 V — 2 batteries</field>
            <field name="default_code">PER-003</field>
            <field name="barcode">2000000000039</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">149.00</field>
            <field name="standard_price">96.00</field>
        </record>

        <record id="product_batterie" model="product.product">
            <field name="name">Batterie 18 V 4 Ah</field>
            <field name="default_code">BAT-004</field>
            <field name="barcode">2000000000046</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">59.00</field>
            <field name="standard_price">34.50</field>
        </record>

        <record id="product_gants" model="product.product">
            <field name="name">Gants de protection taille L — paire</field>
            <field name="default_code">GAN-005</field>
            <field name="barcode">2000000000053</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">4.20</field>
            <field name="standard_price">1.85</field>
        </record>

        <record id="product_casque" model="product.product">
            <field name="name">Casque de chantier — blanc</field>
            <field name="default_code">CAS-006</field>
            <field name="barcode">2000000000060</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">18.50</field>
            <field name="standard_price">8.90</field>
        </record>

        <!-- ============================================================= -->
        <!-- Stock de départ                                                -->
        <!-- ============================================================= -->
        <record id="quant_vis_a1" model="stock.quant">
            <field name="product_id" ref="product_vis_m6"/>
            <field name="location_id" ref="loc_a1"/>
            <field name="quantity" eval="240.0"/>
        </record>

        <record id="quant_ecu_a1" model="stock.quant">
            <field name="product_id" ref="product_ecu_m6"/>
            <field name="location_id" ref="loc_a1"/>
            <field name="quantity" eval="180.0"/>
        </record>

        <record id="quant_perceuse_a2" model="stock.quant">
            <field name="product_id" ref="product_perceuse"/>
            <field name="location_id" ref="loc_a2"/>
            <field name="quantity" eval="12.0"/>
        </record>

        <record id="quant_batterie_a2" model="stock.quant">
            <field name="product_id" ref="product_batterie"/>
            <field name="location_id" ref="loc_a2"/>
            <field name="quantity" eval="25.0"/>
        </record>

        <record id="quant_gants_b1" model="stock.quant">
            <field name="product_id" ref="product_gants"/>
            <field name="location_id" ref="loc_b1"/>
            <field name="quantity" eval="60.0"/>
        </record>

        <record id="quant_casque_b1" model="stock.quant">
            <field name="product_id" ref="product_casque"/>
            <field name="location_id" ref="loc_b1"/>
            <field name="quantity" eval="40.0"/>
        </record>

        <!-- ============================================================= -->
        <!-- Comptes de démonstration                                        -->
        <!-- ============================================================= -->
        <record id="user_pda_operator" model="res.users">
            <field name="name">Karim — Opérateur PDA</field>
            <field name="login">pda.operateur</field>
            <field name="password">pda.operateur</field>
            <field name="email">operateur@demo.local</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('pda_base.group_pda_user'),
                ref('stock.group_stock_user'),
            ])]"/>
        </record>

        <record id="user_pda_manager" model="res.users">
            <field name="name">Sophie — Responsable PDA</field>
            <field name="login">pda.responsable</field>
            <field name="password">pda.responsable</field>
            <field name="email">responsable@demo.local</field>
            <field name="group_ids" eval="[(6, 0, [
                ref('pda_base.group_pda_manager'),
                ref('stock.group_stock_manager'),
            ])]"/>
        </record>

    </data>
</odoo>
