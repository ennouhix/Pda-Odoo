<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_pos_session_form_hanout" model="ir.ui.view">
            <field name="name">pos.session.form.hanout</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_hanout_view_expenses"
                            class="oe_stat_button"
                            icon="fa-money"
                            type="object">
                        <field name="hanout_expense_total" widget="statinfo"
                               string="Dépenses"/>
                    </button>
                </xpath>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Clôture hanout" name="hanout_closing">
                            <group>
                                <group string="Caisse">
                                    <field name="hanout_shop_id"/>
                                    <field name="cash_register_balance_start"/>
                                    <field name="hanout_expense_total"/>
                                    <field name="cash_register_balance_end"/>
                                    <field name="cash_register_balance_end_real"
                                           invisible="state != 'closed'"/>
                                    <field name="cash_register_difference"
                                           invisible="state != 'closed'"/>
                                </group>
                            </group>
                            <group string="Dépenses de la session">
                                <button name="action_hanout_view_expenses"
                                        type="object"
                                        string="Saisir une dépense"
                                        class="btn-link"
                                        icon="fa-plus"/>
                                <field name="hanout_expense_ids" nolabel="1" colspan="2">
                                    <list create="0" edit="0" delete="0">
                                        <field name="date"/>
                                        <field name="name"/>
                                        <field name="category"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="user_id"/>
                                    </list>
                                </field>
                            </group>
                            <div class="text-muted">
                                Le théorique de caisse et l'écart de comptage
                                tiennent compte des dépenses saisies ci-dessus.
                            </div>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

        <record id="view_pos_session_list_hanout" model="ir.ui.view">
            <field name="name">pos.session.list.hanout</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='config_id']" position="after">
                    <field name="hanout_shop_id" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='cash_register_balance_end']" position="after">
                    <field name="hanout_expense_total" optional="show"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
