<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Cloisonnement par société : un utilisateur ne voit que les
             magasins et les dépenses de ses sociétés autorisées, même via
             une recherche sans domaine. -->
        <record id="rule_hanout_shop_company" model="ir.rule">
            <field name="name">Hanout : magasins de la société</field>
            <field name="model_id" ref="model_hanout_shop"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_hanout_expense_company" model="ir.rule">
            <field name="name">Hanout : dépenses de la société</field>
            <field name="model_id" ref="model_hanout_expense"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
