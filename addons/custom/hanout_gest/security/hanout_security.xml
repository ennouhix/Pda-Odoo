<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Catégorie et privilège affichés dans la fiche utilisateur. -->
        <record id="module_category_hanout" model="ir.module.category">
            <field name="name">Hanout</field>
            <field name="sequence">27</field>
        </record>

        <record id="res_groups_privilege_hanout" model="res.groups.privilege">
            <field name="name">Hanout</field>
            <field name="category_id" ref="module_category_hanout"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_hanout_caissier" model="res.groups">
            <field name="name">Caissier Hanout</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_hanout"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_user'))]"/>
            <field name="comment">Vente en caisse, saisie des dépenses du jour et
                clôture de sa session.</field>
        </record>

        <record id="group_hanout_gerant" model="res.groups">
            <field name="name">Gérant Hanout</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_hanout"/>
            <field name="implied_ids" eval="[(4, ref('group_hanout_caissier'))]"/>
            <field name="comment">Gérant : configuration des magasins et des
                caisses, contrôle des dépenses.</field>
        </record>

    </data>
</odoo>
